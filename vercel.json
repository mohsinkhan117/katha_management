{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "admin-web": {
      "root": "admin-web",
      "framework": "nextjs"
    },
    "company-web": {
      "root": "company-web",
      "framework": "nextjs"
    }
  },
  "rewrites": [
    {
      "source": "/admin",
      "destination": { "service": "admin-web" }
    },
    {
      "source": "/admin/(.*)",
      "destination": { "service": "admin-web" }
    },
    {
      "source": "/(.*)",
      "destination": { "service": "company-web" }
    }
  ]
}
